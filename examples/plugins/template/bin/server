#!/usr/bin/env python3
"""Local stdio server: a digest is computed from the supplied UTF-8 text."""
import hashlib
import json
import sys
from pathlib import Path


manifest = json.loads((Path(__file__).resolve().parents[1] / ".codex-plugin/plugin.json").read_text())
tool = manifest["vool"]["tools"][0]
schema = tool["input_schema"]

for line in sys.stdin:
    request = None
    try:
        request = json.loads(line)
        identity = request.get("id")
        if identity is None:
            continue
        method = request.get("method")
        if method == "initialize":
            result = {"protocolVersion": "2025-06-18", "capabilities": {"tools": {}},
                      "serverInfo": {"name": "text-digest", "version": "1.0.0"}}
        elif method == "tools/list":
            result = {"tools": [{"name": "sha256_text", "description": tool["description"], "inputSchema": schema}]}
        elif method == "tools/call":
            parameters = request.get("params", {})
            arguments = parameters.get("arguments", {})
            text = arguments.get("text")
            if parameters.get("name") != "sha256_text" or set(arguments) != {"text"} or not isinstance(text, str) or len(text) > 4096:
                raise ValueError("Supply text to the declared digest tool.")
            encoded = text.encode("utf-8")
            output = {"sha256": hashlib.sha256(encoded).hexdigest(), "bytes": len(encoded)}
            result = {"content": [{"type": "text", "text": json.dumps(output)}], "isError": False}
        else:
            raise ValueError("Unsupported operation.")
        response = {"jsonrpc": "2.0", "id": identity, "result": result}
    except (ValueError, TypeError, AttributeError):
        response = {"jsonrpc": "2.0", "id": request.get("id") if isinstance(request, dict) else None,
                    "error": {"code": -32602, "message": "The request does not match this server's declared tools."}}
    print(json.dumps(response), flush=True)
