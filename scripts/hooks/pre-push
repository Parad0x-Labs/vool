#!/bin/sh
# VOOL public-push ACCIDENT GUARD. Installed to .git/hooks/pre-push via scripts/install-hooks.
#
# The public repo is Parad0x-Labs/vool. PR branches are pushed there as usual. A push that
# updates or deletes refs/heads/main, or pushes a tag, passes only on the release path:
# scripts/vool-public-release sets VOOL_PUBLIC_RELEASE=1 after a GO approval
# (VOOL-DELIVERY/GO_APPROVAL.json).
# Parad0x-Labs/nulla-local is retired: every push to it is refused.
# Parad0x-Labs/nulla-local-product and other GitHub remotes are allowed. Fails CLOSED on an
# unknown or empty remote.
#
# NOTE: a local hook is bypassable (--no-verify / another clone). GitHub branch protection on
# vool main is the authoritative backstop (VOOL-DELIVERY/BRANCH_PROTECTION.md).

remote_url="$2"
if [ -z "$remote_url" ]; then
  echo "pre-push: cannot determine the remote URL -- refusing (fail closed)." >&2
  exit 1
fi

norm=$(printf '%s' "$remote_url" | tr 'A-Z' 'a-z')
norm=${norm%/}
norm=${norm%.git}

case "$norm" in
  *github.com*[:/]parad0x-labs/vool)
    release=0
    if [ "$VOOL_PUBLIC_RELEASE" = "1" ] && [ -f "VOOL-DELIVERY/GO_APPROVAL.json" ]; then
      release=1
    fi
    status=0
    while read -r local_ref local_sha remote_ref remote_sha; do
      case "$remote_ref" in
        refs/heads/main|refs/tags/*)
          if [ "$release" != "1" ]; then
            echo "pre-push: BLOCKED push to $remote_ref on the PUBLIC repo ($remote_url)." >&2
            status=1
          fi ;;
      esac
    done
    if [ "$status" != "0" ]; then
      echo "main and tags change ONLY through scripts/vool-public-release after an explicit GO." >&2
    fi
    exit "$status" ;;
  *github.com*[:/]parad0x-labs/nulla-local)
    echo "pre-push: BLOCKED push to the retired repo ($remote_url)." >&2
    exit 1 ;;
  *github.com*[:/]parad0x-labs/nulla-local-product)
    exit 0 ;;                                   # private product repo -- allowed
  *github.com*)
    exit 0 ;;                                   # some other GitHub remote -- not the public repo
  *)
    echo "pre-push: unrecognized remote ($remote_url) -- refusing (fail closed)." >&2
    exit 1 ;;
esac
