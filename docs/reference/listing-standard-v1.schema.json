              "macos-x86_64",
              "linux-x86_64",
              "windows-x86_64"
            ]
          },
          "description": "Platforms the creator says it works on. Skills default to all four.",
          "x-by": "author",
          "x-from": "NEW"
        },
        "checked_targets": {
          "type": "array",
          "maxItems": 32,
          "description": "Exact VOOL builds the registry's own checks signed this version for. The signer asserts these, never the creator. A format check, not a run of the add-on.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "commit",
              "platform"
            ],
            "properties": {
              "version": {
                "type": "string"
              },
              "commit": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "platform": {
                "enum": [
                  "macos-arm64",
                  "macos-x86_64",
                  "linux-x86_64",
                  "windows-x86_64"
                ]
              }
            }
          },
          "x-by": "registry",
          "x-from": "admission targets (core/registry/trust.py:297-305, admission.py:112)"
        },
        "tested_targets": {
          "type": "array",
          "maxItems": 32,
