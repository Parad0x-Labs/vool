            "properties": {
              "version": {
                "type": "string"
              },
              "platform": {
                "type": "string"
              },
              "date": {
                "type": "integer"
              }
            }
          },
          "description": "Builds a VOOL team member ran this exact version on. Present only with the Tested by VOOL badge.",
          "x-by": "team",
          "x-from": "NEW (extends marks.tested, registry_service/authority.py:113-121)"
        }
      }
    },
