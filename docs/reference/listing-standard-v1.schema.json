          "x-from": "NEW (profile field; falls back to namespace)"
        },
        "bio": {
          "type": "string",
          "maxLength": 500,
          "x-by": "author",
          "x-from": "profile.bio (registry_service/store.py:211)"
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "github": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,64}$"
            },
            "x": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,64}$"
            },
            "mastodon": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://",
              "maxLength": 200
            },
            "website": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://",
              "maxLength": 200
            }
          },
          "description": "What the creator wrote about themselves. Not proof.",
          "x-by": "author",
          "x-from": "profile.handles (store.py:212-222)"
        },
        "verified": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "publisher",
            "providers"
          ],
          "properties": {
            "publisher": {
              "type": "boolean",
              "description": "The account proved it owns this publisher name (GitHub repository owner match, or bytes the service built for it)."
            },
            "providers": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "github",
                  "google",
                  "apple"
                ]
              },
              "description": "Sign-in providers linked to the creator's account. Names only, never ids."
            }
          },
          "x-by": "registry",
          "x-from": "namespace_owners.verified (store.py:313, 880); identities.provider (store.py:263-267, shown only to the owner today)"
        },
        "origin": {
          "enum": [
            "official",
            "community"
          ],
          "x-by": "team",
          "x-from": "curation official_namespaces and marks.teams (registry_service/curation.py:70)"
        }
      }
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[a-z0-9]+([.-][a-z0-9]+)*)?$",
      "x-by": "author",
      "x-from": "metadata.version (codec.VERSION)"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "x-by": "registry",
      "x-from": "artifact_sha256 (registry_service/api.py:158)"
    },
    "package_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 25165824,
      "x-by": "registry",
      "x-from": "artifact_length"
    },
    "changelog": {
      "type": "array",
      "maxItems": 50,
      "description": "Newest first. The registry builds it from each published version's notes, so it cannot be rewritten later.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "date"
        ],
        "properties": {
          "version": {
            "type": "string",
            "maxLength": 64
          },
          "date": {
            "type": "integer",
            "minimum": 0
          },
          "notes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "^[^<>]*$"
          }
        }
      },
      "x-by": "registry",
      "x-from": "metadata.release_notes of every public_versions row (artifact.py:81-84; today only the newest version's notes are shown)"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checked_targets"
      ],
      "properties": {
        "min_vool": {
          "type": "string",
