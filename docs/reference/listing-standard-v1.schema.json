{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vool.dev/schemas/listing-standard-v1.schema.json",
  "title": "VOOL Listing Standard v1",
  "description": "One listing object for every skill and every plugin. The registry service builds it (GET /registry/api/listing?id=...) and the website and the VOOL app render the same object. x-by says who writes a field: author (in the package, covered by its checksum and signed admission), registry (computed by the service from the package, the store or the signed list), team (only the VOOL team, through signed steps). x-from names the field it comes from today, or NEW.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "id",
    "name",
    "tagline",
    "category",
    "subcategory",
    "creator",
    "version",
    "compatibility",
    "needs",
    "access",
    "pictures",
    "license",
    "source",
    "counts",
    "rating",
    "badges",
    "status",
    "dates"
  ],
  "properties": {
    "schema": {
      "const": "vool.listing.v1",
      "x-by": "registry",
      "x-from": "NEW"
    },
    "kind": {
      "enum": [
        "skill",
        "plugin"
      ],
      "x-by": "author",
      "x-from": "metadata.kind (core/registry/artifact.py:99)"
    },
    "plugin_kinds": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 3,
      "items": {
        "enum": [
          "tools",
          "model_provider",
          "scanner"
        ]
      },
      "description": "Plugins only. What the plugin adds. Named plugin_kinds so it never collides with kind.",
      "x-by": "registry",
      "x-from": "manifest vool.kind (core/plugin_manifest.py:45)"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}/[a-z0-9][a-z0-9-]{0,63}$",
      "description": "Stable publisher/name. Never changes; ratings, counts and reviews stay with it.",
      "x-by": "author",
      "x-from": "metadata.id (artifact.py:96-98)"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "pattern": "^[^<>\\u0000-\\u001f]+$",
      "description": "Display name, plain text. Falls back to the name half of id when the author set none.",
      "x-by": "author",
      "x-from": "metadata.title (artifact.py:91-95); plugins: vool.name"
    },
    "tagline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[^\\u0000-\\u001f]+$",
      "description": "Short description: one plain sentence shown on cards and in search. A package with a listing block keeps it to 20 to 140 characters with no < or >; an earlier package may carry up to 500. Always shown as text.",
      "x-by": "author",
      "x-from": "metadata.summary (artifact.py:102, limit 500 today); plugins: vool.description first sentence"
    },
    "description": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "text",
        "tree"
      ],
      "description": "Long description for the detail page. Markdown subset: paragraphs, headings # to ###, bullet and numbered lists, **bold**, *italic*, `code`, fenced code blocks. No raw HTML, no images, no tables, no active links (a URL shows as text; real links go in links). The characters < and > are allowed only inside code. The service parses it to a small tree and both clients build DOM nodes from that tree with textContent; neither ever sets HTML from it. It gets the same text checks as SKILL.md. Left out for a package published without a listing block. tree is the same text already read into blocks; a client that prefers to read text itself must end with the same text nodes.",
      "properties": {
        "format": {
          "const": "markdown-subset-1"
        },
        "text": {
          "type": "string",
          "minLength": 80,
          "maxLength": 6000
        },
        "tree": {
          "$ref": "#/$defs/tree"
        }
      },
      "x-by": "author",
      "x-from": "NEW (listing.description in the package's registry.json; today only summary and SKILL.md exist)"
    },
    "category": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,40}$",
      "description": "Slug from the fixed taxonomy (11 categories).",
      "x-by": "author",
      "x-from": "metadata.category (core/registry/categories.py:9-47)"
    },
    "subcategory": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,40}$",
      "description": "Slug under that category (51 in all).",
      "x-by": "author",
      "x-from": "metadata.subcategory"
    },
    "category_label": {
      "type": "string",
      "maxLength": 60,
      "x-by": "registry",
      "x-from": "public_taxonomy() (categories.py:55-57)"
    },
    "subcategory_label": {
      "type": "string",
      "maxLength": 60,
      "x-by": "registry",
      "x-from": "public_taxonomy()"
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(any|[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?)$"
      },
      "x-by": "author",
      "x-from": "metadata.languages (core/registry/requirements.py:43-49)"
    },
    "creator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "display_name",
        "origin",
        "verified"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "x-by": "registry",
          "x-from": "first half of id; accounts.namespace"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "pattern": "^[^<>\\u0000-\\u001f]+$",
