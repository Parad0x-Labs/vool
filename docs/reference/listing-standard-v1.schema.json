          "x-by": "author",
          "x-from": "NEW"
        },
        "max_vool": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "description": "Optional. Leave out unless a newer VOOL is known not to work.",
          "x-by": "author",
          "x-from": "NEW"
        },
