{
  "corpus_version": "1.0.0",
  "base_commit": "dca4679fccd777554c4ad9f9653f0a3e8406b0ef",
  "split_declaration": {
    "declared_before_any_run": true,
    "rule": "dev scenarios were used while authoring the harness; heldout scenarios were never run until the recorded baseline; control scenarios are guard self-proofs, excluded from pass/fail scores",
    "dev": [
      "auto-easy-chat",
      "auto-reasoning-local-vs-cloud",
      "auto-strict-json",
      "auto-tool-intent",
      "pinned-local-serves",
      "pinned-unresolved-fails-closed",
      "local-only-no-cloud-egress",
      "free-cloud-verified-no-paid",
      "paid-authorized-owner-pick",
      "paid-missing-approval-no-dispatch",
      "retry-timeout-fallback",
      "circuit-preopen-skips",
      "ratelimit-all-candidates",
      "empty-then-fallback",
      "stale-catalog-free-revoked",
      "vision-excluded-from-text",
      "multilingual-lithuanian",
      "long-payload-context-window",
      "seq-local-only-isolation",
      "seq-complexity-change"
    ],
    "heldout": [
      "h-pin-cloud-error-no-silent-local",
      "h-quota-exhaustion-typed-failure",
      "h-malformed-toolcall-not-fake-success",
      "h-complexity-growth-3turns",
      "h-free-cloud-only-no-local"
    ],
    "control": [
      "c-guard-external-host"
    ]
  },
  "scenarios": [
    {
      "id": "auto-easy-chat",
      "split": "dev",
      "category": "task-mix/auto-easy",
      "intent": "ordinary easy chat under Auto: local and catalog-verified free-cloud lanes both registered; the turn must complete on a non-paid lane",
      "env": {
        "manifests": [
          "local_small",
          "local_big",
          "free_cloud_verified"
        ],
        "catalog": [
          "free:tiny-free"
        ]
      },
      "transport": {
        "default": "ok_text:Hello! I can help you write, plan, analyze files, answer questions, and run local tools. What would you like to work on today?"
      },
      "mode": {
        "type": "auto"
      },
      "turns": [
        {
          "user_text": "hi! what can you help me with today?",
          "task_kind": "qa_short",
          "output_mode": "plain_text"
        }
      ],
      "expect": {
        "status_in": [
          "completed"
        ],
        "chosen_cost_class_in": [
          "free_local",
          "free_cloud"
        ],
        "no_dispatch_to": [],
        "checks": [
          "usage_row_recorded"
        ]
      }
    },
    {
      "id": "auto-reasoning-local-vs-cloud",
      "split": "dev",
      "category": "task-mix/multi-step-reasoning",
      "intent": "multi-step reasoning demand under Auto: completion on a non-paid lane, chosen model recorded (identity is observed, not predicted)",
      "env": {
        "manifests": [
          "local_big",
          "free_cloud_verified"
        ],
        "catalog": [
          "free:tiny-free"
        ]
      },
      "transport": {
        "default": "ok_text:First, replicate the database with streaming replication so the standby stays current. Second, route reads to the standby while writes continue on the primary. Third, promote the standby in a short transaction and switch the writers, then verify row counts and checksums before decommissioning the old primary."
      },
      "mode": {
        "type": "auto"
      },
      "turns": [
        {
          "user_text": "Plan how to migrate a postgres database with zero downtime: list constraints, steps, risks, and verification for each step.",
          "task_kind": "reasoning",
          "output_mode": "plain_text"
        }
      ],
      "expect": {
        "status_in": [
          "completed"
        ],
        "chosen_cost_class_in": [
          "free_local",
          "free_cloud"
        ],
        "no_dispatch_to": [],
        "checks": [
          "usage_row_recorded"
        ]
      }
    },
    {
      "id": "auto-strict-json",
      "split": "dev",
      "category": "format/strict-json",
      "intent": "strict JSON output: a manifest without structured_json must be hard-excluded; the envelope must carry response_format; the answer must parse as JSON",
      "env": {
        "manifests": [
          "local_nocap",
          "free_cloud_verified"
        ],
        "catalog": [
          "free:tiny-free"
        ]
      },
      "transport": {
        "by_manifest": {
          "free_cloud_verified": "ok_json:{\"answer\": \"synthetic json\", \"confidence\": 0.9}"
        },
        "default": "ok_text:plain text"
      },
      "mode": {
        "type": "auto"
      },
      "turns": [
        {
          "user_text": "Return strict JSON with keys answer and confidence for: what is 2+2?",
          "task_kind": "reasoning",
          "output_mode": "json_object"
        }
      ],
      "expect": {
        "status_in": [
          "completed"
        ],
        "no_dispatch_to": [
          "local_nocap"
        ],
        "checks": [
          "envelope_carries_response_format",
          "usage_row_recorded"
        ]
      }
    },
    {
      "id": "auto-tool-intent",
      "split": "dev",
      "category": "tools/native-tool-calls",
      "intent": "tool_intent turn: the chosen model must be offered tools (or the structured fallback), a native tool call must be parsed, and a no-tool-capability manifest must never serve",
      "env": {
        "manifests": [
          "local_small",
          "free_cloud_verified"
        ],
        "catalog": [
          "free:tiny-free"
        ]
      },
      "transport": {
        "by_manifest": {
          "free_cloud_verified": "ok_toolcall:workspace__read_file:{\"path\": \"/synthetic/notes.txt\"}"
        },
        "default": "ok_text:I would read the file for you."
      },
      "mode": {
        "type": "auto"
      },
      "turns": [
        {
          "user_text": "read the file /synthetic/notes.txt and summarize it",
          "task_kind": "tool_intent",
          "output_mode": "tool_intent"
        }
      ],
      "expect": {
        "status_in": [
          "completed",
          "refused",
          "infra_or_unresolved"
        ],
        "no_dispatch_to": [
          "local_small"
        ],
        "checks": [
          "envelope_carries_tools_or_json",
          "tool_call_observed_or_typed_failure"
        ]
      }
    },
    {
      "id": "pinned-local-serves",
      "split": "dev",
      "category": "pin/contract",
      "intent": "explicit pin to a registered local model must serve exactly that model",
      "env": {
        "manifests": [
          "local_small",
          "local_big"
        ]
      },
      "transport": {
        "default": "ok_text:Quicksort picks a pivot, partitions the array around it, and recursively sorts both sides. It averages O(n log n) time and sorts in place. In the worst case, such as an already sorted array with a poor pivot, it degrades to O(n squared)."
      },
      "mode": {
        "type": "pinned",
        "pin_manifest": "local_big"
      },
      "turns": [
        {
          "user_text": "explain quicksort in three sentences",
          "task_kind": "reasoning",
          "output_mode": "plain_text"
        }
      ],
      "expect": {
        "status_in": [
          "completed"
        ],
        "chosen_manifest_in": [
          "local_big"
        ],
        "no_dispatch_to": [
          "local_small"
        ],
        "checks": [
          "usage_row_recorded"
        ]
      }
    },
    {
      "id": "pinned-unresolved-fails-closed",
      "split": "dev",
      "category": "pin/fail-closed",
      "intent": "a pin naming a model that is not registered must fail closed with an explicit unavailable decision, dispatch nothing, and never silently substitute another model",
      "env": {
        "manifests": [
          "local_big"
        ]
      },
      "transport": {
        "default": "ok_text:should never be sent"
      },
      "mode": {
