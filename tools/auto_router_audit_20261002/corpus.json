    {
      "id": "paid-authorized-owner-pick",
      "split": "dev",
      "category": "policy/paid-authorized",
      "intent": "owner-local explicit paid pick with an escalation policy in place: the paid lane must execute exactly once, with one joinable reservation+settlement receipt pair and a usage row",
      "env": {
        "manifests": [
          "local_big",
          "paid_cloud"
        ],
        "cloud_escalation": {
          "mode": "off",
          "daily_cap": 25
        }
      },
      "transport": {
        "by_manifest": {
          "paid_cloud": "ok_text:This repository implements a local-first AI assistant: a routing layer selects between local models and cloud providers, a tool executor runs authorized actions, and a storage layer keeps sessions and usage. The core design goal is that privacy and cost boundaries are enforced by the router itself rather than by user discipline."
        },
        "default": "ok_text:Thank you for the thoughtful feedback on the draft. I am glad the structure worked, and I will keep the closing shorter next time."
      },
      "mode": {
        "type": "pinned",
        "pin_manifest": "paid_cloud",
        "owner_local": true
      },
      "turns": [
        {
          "user_text": "explain this repository in depth",
          "task_kind": "reasoning",
          "output_mode": "plain_text"
        }
      ],
      "expect": {
        "status_in": [
          "completed"
        ],
        "chosen_manifest_in": [
          "paid_cloud"
        ],
        "checks": [
          "paid_receipt_pair",
          "usage_row_recorded",
          "single_dispatch_to_paid"
        ]
      }
    },
