        "pin_manifest_absent": "synthetic-paid:frontier-xl"
      },
      "turns": [
        {
          "user_text": "summarize this chapter",
          "task_kind": "summarization",
          "output_mode": "plain_text"
        }
      ],
      "expect": {
        "status_in": [
          "refused"
        ],
        "no_dispatch_any": true,
        "checks": [
          "no_transport_calls"
        ]
      }
    },
    {
      "id": "local-only-no-cloud-egress",
