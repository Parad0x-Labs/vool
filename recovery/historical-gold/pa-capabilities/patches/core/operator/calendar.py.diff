 from datetime import datetime, timedelta, timezone
 from typing import Any
+from zoneinfo import ZoneInfo, ZoneInfoNotFoundError
 
 _TIME_RE = re.compile(r"\bat\s+(\d{1,2})(?::(\d{2}))?\s*(am|pm)?\b", re.IGNORECASE)
 _ISO_DATETIME_RE = re.compile(r"\b(20\d{2}-\d{2}-\d{2})(?:[ T](\d{1,2}:\d{2}))?\b")
 _DURATION_RE = re.compile(r"\bfor\s+(\d+)\s*(m|min|mins|minute|minutes|h|hr|hrs|hour|hours)\b", re.IGNORECASE)
+# An explicit place/zone for the TIME: "at 9am Berlin", "9:00 Europe/Vilnius".
+# A deliberately tiny city map — honest and bounded; unknown places are refused
+# with the machine/user zone rather than guessed.
+_CITY_ZONES: dict[str, str] = {
+    "berlin": "Europe/Berlin",
+    "vilnius": "Europe/Vilnius",
+    "london": "Europe/London",
+    "paris": "Europe/Paris",
+    "madrid": "Europe/Madrid",
+    "rome": "Europe/Rome",
+    "new york": "America/New_York",
+    "york": "America/New_York",
+    "boston": "America/New_York",
+    "chicago": "America/Chicago",
+    "denver": "America/Denver",
+    "los angeles": "America/Los_Angeles",
+    "san francisco": "America/Los_Angeles",
+    "seattle": "America/Los_Angeles",
+    "tokyo": "Asia/Tokyo",
+    "singapore": "Asia/Singapore",
+    "sydney": "Australia/Sydney",
+    "dubai": "Asia/Dubai",
+    "utc": "UTC",
+}
+def _explicit_zone(text: str) -> tuple[str, str] | None:
+    """(zone_name, source) when the text names a place for the time: an IANA
+    identifier verbatim, or one of the small city aliases above."""
+    lowered = str(text or "").lower()
+    for alias in sorted(_CITY_ZONES, key=len, reverse=True):
+        if re.search(rf"\b{re.escape(alias)}\b", lowered):
+            return _CITY_ZONES[alias], "city"
+    for match in re.finditer(r"\b([A-Za-z]+/[A-Za-z_/\-]+)\b", str(text or "")):
+        candidate = match.group(1)
+        try:
+            ZoneInfo(candidate)
+            return candidate, "iana"
+        except (ZoneInfoNotFoundError, ValueError):
+            continue
+    return None
+
+
+def _dst_status(naive_dt: datetime, tz: ZoneInfo) -> str:
+    """'unique' | 'ambiguous' (fall-back overlap) | 'nonexistent' (spring-forward gap).
+
+    The parser never silently invents a time: an ambiguous time is pinned to the
+    FIRST occurrence (fold=0, the pre-transition offset) and a nonexistent one is
+    shifted per zoneinfo's wall-clock arithmetic — both annotated in the scope so
+    the preview can say so."""
+    dt0 = naive_dt.replace(tzinfo=tz, fold=0)
+    dt1 = naive_dt.replace(tzinfo=tz, fold=1)
+    r0 = dt0.astimezone(timezone.utc).astimezone(tz).replace(tzinfo=None)
+    if r0 != naive_dt:
+        return "nonexistent"
+    if dt0.utcoffset() != dt1.utcoffset():
+        return "ambiguous"
+    return "unique"
 
 
